font=JetBrainsMono Nerd Font 10
background-color=#263A32
text-color=#E4D5B5
border-color=#87947B

border-size=2
border-radius=8
padding=12
margin=8
width=360
height=120

anchor=top-right
layer=overlay
sort=-time
max-visible=5

default-timeout=5000
ignore-timeout=0

icons=1
max-icon-size=40

format=<b>%s</b>\n%b
markup=1

[urgency=low]
background-color=#34483C
text-color=#AAB8A0
border-color=#526A54
default-timeout=3000

[urgency=normal]
background-color=#263A32
text-color=#E4D5B5
border-color=#C49A53
default-timeout=5000

[urgency=high]
background-color=#263A32
text-color=#E4D5B5
border-color=#A65D45
border-size=3
default-timeout=0
